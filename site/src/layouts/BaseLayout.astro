---
import {
  CONFIG,
  PUBLICATION_AT_URI,
  SITE_DESCRIPTION,
  SITE_LANGUAGE,
  SITE_NAME,
  WEBMENTION_ENDPOINT,
  absoluteUrl,
  DEFAULT_OG_IMAGE,
} from '@hexx/shared';
import { toJsonLd } from '../lib/json.ts';
import '../styles/global.css';

interface Props {
  /** ページ固有のタイトル。サイト名が自動で付く */
  title?: string;
  description?: string;
  /** Canonical URL（絶対） */
  canonical: string;
  ogType?: 'website' | 'article';
  coverImage?: string;
  /** Document ページのみ。head に standard.site の発見ヒントを出す */
  documentAtUri?: string;
  publishedAt?: Date;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonical,
  ogType = 'website',
  coverImage,
  documentAtUri,
  publishedAt,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const jsonLdText = jsonLd ? toJsonLd(jsonLd) : null;
const ogImage = absoluteUrl(coverImage ?? DEFAULT_OG_IMAGE);
const navItems = [
  { href: '/', label: 'ホーム' },
  { href: '/posts', label: '記事' },
  { href: '/notes', label: 'ノート' },
  { href: '/tags', label: 'タグ' },
  { href: '/about', label: 'About' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} (RSS)`} href="/feed.xml" />
    <link
      rel="alternate"
      type="application/feed+json"
      title={`${SITE_NAME} (JSON Feed)`}
      href="/feed.json"
    />

    {/* standard.site: publication は全ページ、document は記事ページに出す */}
    <link rel="site.standard.publication" href={PUBLICATION_AT_URI} />
    {documentAtUri && <link rel="site.standard.document" href={documentAtUri} />}

    <link rel="webmention" href={WEBMENTION_ENDPOINT} />
    {CONFIG.relMe.map((href) => <link rel="me" href={href} />)}
    <meta name="generator" content={Astro.generator} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">{SITE_NAME}</a>
        <nav class="site-nav">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>&copy; {new Date().getFullYear()} {CONFIG.author.name}</span>
        <a href="/feed.xml">RSS</a>
        <a href="/feed.json">JSON Feed</a>
        {CONFIG.relMe.map((href) => <a href={href} rel="me">{new URL(href).host}</a>)}
      </div>
    </footer>
  </body>
</html>
