---
import { absoluteUrl } from '@hexx/shared';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocumentList from '../../components/DocumentList.astro';
import { filterByKind, getPublishedDocuments } from '../../lib/documents';

const documents = filterByKind(await getPublishedDocuments(), 'note');
---

<BaseLayout title="ノート" canonical={absoluteUrl('/notes')} description="短文のノート一覧。">
  <h1 class="page-title">ノート</h1>
  <p class="lede">短く書いたもの。SNS へそのまま流れる。</p>
  <DocumentList documents={documents} emptyMessage="まだノートがありません。" />
</BaseLayout>
