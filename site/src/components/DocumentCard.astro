---
import type { Document } from '../lib/documents';
import { formatListDate } from '../lib/format';

interface Props {
  doc: Document;
  /** 年見出しの下に並ぶときは h3 にする */
  titleTag?: 'h2' | 'h3';
}

const { doc, titleTag: TitleTag = 'h2' } = Astro.props;
const kindLabel = doc.kind === 'post' ? 'Post' : 'Note';
---

<li class="doc-row">
  <div class="doc-row__head">
    <span class="kind-label">{kindLabel}</span>
    <TitleTag class="doc-row__title">
      <a href={doc.path} title={doc.title}>{doc.title}</a>
    </TitleTag>
    <span class="doc-row__leader" aria-hidden="true"></span>
    <time class="doc-row__date" datetime={doc.publishedAt.toISOString()}>
      {formatListDate(doc.publishedAt)}
    </time>
  </div>
  {doc.description && <p class="doc-row__summary">{doc.description}</p>}
  {
    doc.tags.length > 0 && (
      <ul class="tag-list">
        {doc.tags.map((tag) => (
          <li>
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</li>
